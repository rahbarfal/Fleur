# Copy to .env.local and fill in.
# Local:    postgres://fleur:<password>@localhost:5432/fleur
# Supabase: the "Transaction pooler" URI (port 6543) from Supabase → Connect
DATABASE_URL=

# Optional: a session-pooler or direct URL for migrations/scripts.
# Falls back to DATABASE_URL.
# MIGRATE_DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 locally, https://<your-app>.vercel.app in production
BETTER_AUTH_URL=

# ---- Gmail (optional; README → Gmail). Google Cloud → Google Auth Platform → Clients → Web client.
# Redirect URI to register: <BETTER_AUTH_URL>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Google tokens: openssl rand -base64 32
GMAIL_TOKEN_KEY=
# Protects the daily sync endpoint (Vercel sends it automatically): openssl rand -base64 32
CRON_SECRET=

# ---- Demo ("Try the demo" on the login page). On unless set to false.
# DEMO_ENABLED=false

# ---- Production database for scripts run from your Mac (db:migrate:supabase, user:copy, demo:cron).
# Put this in a separate, gitignored .env.supabase (NOT in .env.local, NOT on Vercel):
# SUPABASE_DB_URL=<Supabase pooler URI: Transaction pooler (6543) or Session pooler (5432)>
