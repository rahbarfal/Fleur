    "@tiptap/core": "3.33.0",
    "@tiptap/extension-collaboration": "3.33.0",
    "@tiptap/extension-drag-handle": "3.33.0",
    "@tiptap/extension-drag-handle-react": "3.33.0",
    "@tiptap/extension-highlight": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extension-node-range": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "better-auth": "1.6.34",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "next": "^15.5.29",
    "postgres": "3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.33",
