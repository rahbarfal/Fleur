{
  "name": "fleur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:email": "tsx --test src/lib/email/classify.test.ts src/lib/email/finance/finance.test.ts",
    "test:notes": "tsx --test src/lib/notes/markdown.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:supabase": "tsx --env-file-if-exists=.env.local src/scripts/migrate-supabase.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env.local src/scripts/seed.ts",
    "db:import-sqlite": "tsx --env-file-if-exists=.env.local src/scripts/import-sqlite.ts",
    "user:create": "tsx --env-file-if-exists=.env.local src/scripts/user-create.ts",
    "user:reset-password": "tsx --env-file-if-exists=.env.local src/scripts/user-reset-password.ts",
    "user:delete": "tsx --env-file-if-exists=.env.local src/scripts/user-delete.ts",
    "user:list": "tsx --env-file-if-exists=.env.local src/scripts/user-list.ts",
    "user:copy": "tsx --env-file-if-exists=.env.local src/scripts/user-copy.ts",
    "demo:cron": "tsx --env-file-if-exists=.env.local src/scripts/demo-cron.ts",
    "email:reparse": "tsx --conditions=react-server --env-file-if-exists=.env.local src/scripts/email-reparse.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
